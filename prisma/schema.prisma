generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  image            String?
  twoFactorEnabled Boolean        @default(false)
  twoFactorSecret  String?
  role             Role           @default(VIEWER)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  emailVerified    Boolean        @default(false)
  apiKeys          APIKey[]
  accounts         Account[]
  auditLogs        AuditLog[]
  folders          Folder[]
  memberships      Member[]
  notifications    Notification[]
  createdQRs       QRCode[]
  sessions         Session[]
  tags             Tag[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  token     String   @unique
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  logo             String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  apiKeys          APIKey[]
  auditLogs        AuditLog[]
  billingAuditLogs BillingAuditLog[]
  coupons          CouponUsage[]
  customDomains    CustomDomain[]
  folders          Folder[]
  invoices         Invoice[]
  members          Member[]
  payments         Payment[]
  qrCodes          QRCode[]
  subscription     Subscription?
  tags             Tag[]
  usageCounters    UsageCounter[]
  usageEvents      UsageEvent[]
  webhooks         Webhook[]
}

model Member {
  id             String       @id @default(cuid())
  role           Role         @default(EDITOR)
  userId         String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model QRCode {
  id              String       @id @default(cuid())
  title           String
  shortCode       String       @unique
  type            QRType       @default(WEBSITE)
  destinationUrl  String
  fallbackUrl     String?
  description     String?
  fgColor         String       @default("#000000")
  bgColor         String       @default("#FFFFFF")
  logoUrl         String?
  logoWidth       Int?
  logoHeight      Int?
  frameTemplate   String?
  frameText       String?
  dotsStyle       String       @default("square")
  cornerDotsStyle String       @default("square")
  passwordHash    String?
  expiresAt       DateTime?
  startsAt        DateTime?
  maxScans        Int?
  scanCount       Int          @default(0)
  isArchived      Boolean      @default(false)
  isFavorite      Boolean      @default(false)
  isInTrash       Boolean      @default(false)
  redirectRules   Json?
  organizationId  String
  creatorId       String
  folderId        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  creator         User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  folder          Folder?      @relation(fields: [folderId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions        QRVersion[]
  scans           ScanEvent[]
  tags            TagOnQR[]
}

model QRVersion {
  id             String   @id @default(cuid())
  qrCodeId       String
  destinationUrl String
  redirectRules  Json?
  versionNumber  Int
  createdAt      DateTime @default(now())
  qrCode         QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
}

model Folder {
  id             String       @id @default(cuid())
  name           String
  color          String?      @default("#4F46E5")
  organizationId String
  creatorId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  creator        User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  qrCodes        QRCode[]
}

model Tag {
  id             String       @id @default(cuid())
  name           String
  color          String?      @default("#06B6D4")
  organizationId String
  creatorId      String
  createdAt      DateTime     @default(now())
  creator        User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  qrCodes        TagOnQR[]

  @@unique([name, organizationId])
}

model TagOnQR {
  qrCodeId String
  tagId    String
  qrCode   QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([qrCodeId, tagId])
}

model ScanEvent {
  id          String   @id @default(cuid())
  qrCodeId    String
  timestamp   DateTime @default(now())
  ipAddress   String?
  country     String?
  region      String?
  city        String?
  browser     String?
  device      String?
  os          String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  language    String?
  timezone    String?
  screenSize  String?
  isUnique    Boolean  @default(true)
  isReturning Boolean  @default(false)
  qrCode      QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// BILLING & SUBSCRIPTION SYSTEM
// ─────────────────────────────────────────────

model Plan {
  id                    String            @id @default(cuid())
  name                  String
  slug                  String            @unique
  description           String?
  monthlyPrice          Int               @default(0)
  yearlyPrice           Int               @default(0)
  currency              String            @default("INR")
  trialDays             Int               @default(0)
  isFree                Boolean           @default(false)
  isActive              Boolean           @default(true)
  isRecommended         Boolean           @default(false)
  sortOrder             Int               @default(0)
  razorpayPlanIdMonthly String?
  razorpayPlanIdYearly  String?
  marketingFeatures     Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  entitlements          PlanEntitlement[]
  subscriptions         Subscription[]
  nextPlanSubscriptions Subscription[]    @relation("NextPlan")
}

model PlanEntitlement {
  id             String              @id @default(cuid())
  planId         String
  entitlementKey String
  valueType      EntitlementValueType
  numericValue   Int?
  booleanValue   Boolean?
  createdAt      DateTime            @default(now())
  plan           Plan                @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, entitlementKey])
}

model Subscription {
  id                     String               @id @default(cuid())
  organizationId         String               @unique
  planId                 String?
  razorpaySubscriptionId String?              @unique
  razorpayCustomerId     String?
  status                 SubscriptionStatus   @default(INACTIVE)
  billingCycle           BillingCycle?
  amount                 Int?
  currency               String               @default("INR")
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialStart             DateTime?
  trialEnd               DateTime?
  cancelAtPeriodEnd      Boolean              @default(false)
  canceledAt             DateTime?
  endedAt                DateTime?
  nextPlanId             String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  plan                   Plan?                @relation(fields: [planId], references: [id])
  nextPlan               Plan?                @relation("NextPlan", fields: [nextPlanId], references: [id])
  payments               Payment[]
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events                 SubscriptionEvent[]
  invoices               Invoice[]

  @@index([status])
  @@index([planId])
}

model Payment {
  id                String        @id @default(cuid())
  subscriptionId    String
  organizationId    String?
  razorpayPaymentId String        @unique
  razorpayOrderId   String?
  amount            Int
  currency          String        @default("INR")
  status            String
  methodType        String?
  failureReason     String?
  receiptUrl        String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organization      Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Invoice {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique
  organizationId    String
  subscriptionId    String?
  providerInvoiceId String?       @unique
  subtotal          Int           @default(0)
  tax               Int           @default(0)
  discount          Int           @default(0)
  total             Int           @default(0)
  currency          String        @default("INR")
  status            InvoiceStatus @default(DRAFT)
  invoiceUrl        String?
  issuedAt          DateTime      @default(now())
  dueAt             DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([organizationId])
}

model UsageCounter {
  id             String       @id @default(cuid())
  organizationId String
  metric         String
  periodStart    DateTime
  periodEnd      DateTime
  usage          Int          @default(0)
  limitSnapshot  Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, periodStart, periodEnd])
  @@index([organizationId, metric])
}

model UsageEvent {
  id             String       @id @default(cuid())
  organizationId String
  metric         String
  quantity       Int          @default(1)
  source         String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metric, createdAt])
}

model BillingWebhookEvent {
  id           String             @id @default(cuid())
  provider     String
  eventId      String
  eventType    String
  payload      Json
  status       WebhookEventStatus @default(PENDING)
  receivedAt   DateTime           @default(now())
  processedAt  DateTime?
  errorMessage String?

  @@unique([provider, eventId])
  @@index([eventType, status])
}

model SubscriptionEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  eventType      String
  previousState  Json?
  newState       Json?
  metadata       Json?
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
}

model BillingAuditLog {
  id             String       @id @default(cuid())
  actorId        String?
  organizationId String
  action         String
  entityType     String
  entityId       String?
  previousState  Json?
  newState       Json?
  requestId      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([action, entityType])
}

// ─────────────────────────────────────────────
// EXISTING DOMAIN MODELS (Unchanged)
// ─────────────────────────────────────────────

model CustomDomain {
  id             String       @id @default(cuid())
  domain         String       @unique
  organizationId String
  verified       Boolean      @default(false)
  sslActive      Boolean      @default(false)
  dnsTxtRecord   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model APIKey {
  id             String       @id @default(cuid())
  name           String
  key            String       @unique
  scopes         String[]
  organizationId String
  creatorId      String
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  creator        User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String       @id @default(cuid())
  action         String
  entity         String
  entityId       String?
  metadata       Json?
  organizationId String
  userId         String?
  ipAddress      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])
}

model Webhook {
  id             String            @id @default(cuid())
  name           String
  url            String
  secret         String
  events         String[]
  isActive       Boolean           @default(true)
  organizationId String
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  event        String
  payload      Json
  responseCode Int?
  error        String?
  deliveredAt  DateTime @default(now())
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
}

model Coupon {
  id              String        @id @default(cuid())
  code            String        @unique
  discountPercent Int?
  discountAmount  Int?
  maxUses         Int?
  usesCount       Int           @default(0)
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  usages          CouponUsage[]
}

model CouponUsage {
  id             String       @id @default(cuid())
  couponId       String
  organizationId String
  usedAt         DateTime     @default(now())
  coupon         Coupon       @relation(fields: [couponId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false)
  rules       Json?
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum QRType {
  WEBSITE
  PDF
  IMAGE
  VIDEO
  VCARD
  EMAIL
  PHONE
  SMS
  WHATSAPP
  WIFI
  APP_STORE
  GOOGLE_PLAY
  GOOGLE_MAPS
  LOCATION
  TEXT
  EVENT
  CALENDAR
  RESTAURANT_MENU
  DIGITAL_BUSINESS_CARD
  SOCIAL_LINKS
  YOUTUBE
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  X
  TIKTOK
  CUSTOM_REDIRECT
}

enum SubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
  INCOMPLETE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum EntitlementValueType {
  BOOLEAN
  NUMERIC
  UNLIMITED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  UNCOLLECTIBLE
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
  SKIPPED
}
